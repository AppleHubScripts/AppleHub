			if not State.BtnRipple then return end
			local lx = (x - box.AbsolutePosition.X) / math.max(uiscale.Scale, 0.1)
			local r = new("Frame", {Size = UDim2.fromOffset(0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, lx, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = grp},
				{new("UICorner", {CornerRadius = UDim.new(1, 0)})})
			tween(r, 0.55, {Size = UDim2.fromOffset(520, 520), BackgroundTransparency = 1})
			task.delay(0.6, function() pcall(function() r:Destroy() end) end)
