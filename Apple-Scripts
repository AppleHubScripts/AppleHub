		o.c2.CornerRadius = UDim.new(0, State.BtnCorner)
		o.label.TextSize = State.BtnTextSize
		o.shine.Visible = State.BtnShine and s ~= "Contorno"
		o.stroke.Enabled = false
		o.grad.Enabled = false
		o.fill.BackgroundTransparency = 0
		o.fill.BackgroundColor3 = T.accent
		o.label.TextColor3 = Color3.new(1, 1, 1)
		if s == "Gradiente" then
			o.grad.Enabled = true
			o.fill.BackgroundColor3 = Color3.new(1, 1, 1)
		elseif s == "Vidro" then
			o.fill.BackgroundColor3 = T.row
			o.fill.BackgroundTransparency = 0.15
			o.stroke.Enabled, o.stroke.Color, o.stroke.Thickness, o.stroke.Transparency = true, T.accent, 1.2, 0.45
			o.label.TextColor3 = T.text
		elseif s == "Neon" then
			o.fill.BackgroundColor3 = T.bg
			o.fill.BackgroundTransparency = 0.1
			o.stroke.Enabled, o.stroke.Color, o.stroke.Thickness, o.stroke.Transparency = true, T.accent, 2, 0
			o.label.TextColor3 = T.accent
		elseif s == "Contorno" then
			o.fill.BackgroundTransparency = 1
			o.stroke.Enabled, o.stroke.Color, o.stroke.Thickness, o.stroke.Transparency = true, T.accent, 1.6, 0
			o.label.TextColor3 = T.accent
		end
	end
	styleAllButtons = function() for _, o in ipairs(btnObjs) do styleBtn(o) end end

	Button = function(page, text, cb)
		local box = new("Frame", {Size = UDim2.new(1, -4, 0, State.BtnH), BackgroundTransparency = 1, Parent = page})
		local c1 = new("UICorner", {Parent = box})
		local stroke = new("UIStroke", {Enabled = false, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box})
		local grp = new("CanvasGroup", {Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = box})
		local c2 = new("UICorner", {Parent = grp})
		local gs = new("UIScale", {Parent = grp})
		local fill = new("Frame", {Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = grp})
		local grad = new("UIGradient", {Parent = fill})
		bind(grad, "Color", function() return ColorSequence.new(T.accent, T.accent2) end, true)
		local shine = new("Frame", {Size = UDim2.new(0.3, 0, 2, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.3, 0, 0.5, 0), Rotation = 20, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = grp})
		new("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.75), NumberSequenceKeypoint.new(1, 1)}), Parent = shine})
		local hov = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = grp})
		local label = mkText({Size = UDim2.fromScale(1, 1), Text = text, TextSize = State.BtnTextSize, Parent = grp}, true, false)
		local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = box})
