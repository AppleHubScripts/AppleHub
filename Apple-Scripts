	mkText({Size = UDim2.new(1, -44, 0, 18), Position = UDim2.fromOffset(40, 3), Text = lp.DisplayName, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = chip}, true)
	chipLv = mkText({Size = UDim2.new(1, -44, 0, 14), Position = UDim2.fromOffset(40, 21), Text = "Lv —", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = chip}, false, "accent")

	local content = new("Frame", {Size = UDim2.new(1, -(State.SideW + 24), 1, -50), Position = UDim2.fromOffset(State.SideW + 18, 42), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main})

	setSideW = function(w)
		side.Size = UDim2.new(0, w, 1, -50)
		content.Position = UDim2.fromOffset(w + 18, 42)
		content.Size = UDim2.new(1, -(w + 24), 1, -50)
		chip.Visible = State.ShowChip
		tabScroll.Size = UDim2.new(1, 0, 1, State.ShowChip and -54 or -8)
	end

	local pages, pageScale, tabY, tabIdx, current, tabCount = {}, {}, {}, {}, nil, 0
	local tabBtns = {}
	local function P(ox, oy) return UDim2.new(0.5, ox, 0.5, oy) end
	local function activeColor() return State.TabStyle == "Pílula" and Color3.new(1, 1, 1) or T.accent end

	switchTab = function(name)
		if current == name then return end
		local oldName = current
		current = name
		for _, f in ipairs(tabRefresh) do f(0.25) end
		local tt = math.max(State.TransTime, 50) / 1000
		local es = ease()
		local kind = State.Transition
		tween(indicator, tt, {Position = UDim2.fromOffset(6, tabY[name])}, es)
		local dir = (oldName and tabIdx[name] < tabIdx[oldName]) and -1 or 1

		if oldName then
			local old, oldS = pages[oldName], pageScale[oldName]
			if kind == "Nenhuma" then
				old.Visible = false
			else
				local goal = {GroupTransparency = 1}
				if kind == "Deslizar" then goal.Position = P(-30 * dir, 0)
				elseif kind == "Subir" then goal.Position = P(0, -30 * dir)
				elseif kind == "Girar" then goal.Rotation = -8 * dir end
				tween(old, tt * 0.5, goal, Enum.EasingStyle.Quad)
				if kind == "Zoom" or kind == "Pop" then tween(oldS, tt * 0.5, {Scale = 1.06}, Enum.EasingStyle.Quad) end
				task.delay(tt * 0.5 + 0.03, function() if current ~= oldName then old.Visible = false end end)
			end
		end

		local pg, ps = pages[name], pageScale[name]
		pg.Position = P(0, 0)
		pg.Rotation = 0
		ps.Scale = 1
		if kind == "Deslizar" then pg.Position = P(34 * dir, 0)
		elseif kind == "Subir" then pg.Position = P(0, 34 * dir)
		elseif kind == "Zoom" then ps.Scale = 0.9
		elseif kind == "Pop" then ps.Scale = 0.7
		elseif kind == "Girar" then pg.Rotation = 8 * dir end
		pg.GroupTransparency = (kind == "Nenhuma") and 0 or 1
		pg.Visible = true
		if kind == "Nenhuma" then return end
		task.delay(tt * 0.2, function()
			if current ~= name then return end
			tween(pg, tt, {GroupTransparency = 0, Position = P(0, 0), Rotation = 0}, es)
			tween(ps, tt, {Scale = 1}, es)
		end)
	end

	addPage = function(name, icon)
		local grp = new("CanvasGroup", {Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = P(0, 0), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = content})
		local ps = new("UIScale", {Parent = grp})
		local sc = new("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = grp,
		}, {
			new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}),
			new("UIPadding", {PaddingRight = UDim.new(0, 8), PaddingLeft = UDim.new(0, 3), PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 12)}),
		})
		bind(sc, "ScrollBarImageColor3", "accent")
		pages[name], pageScale[name] = grp, ps
		tabCount = tabCount + 1
		tabIdx[name] = tabCount
		local y = 8 + (tabCount - 1) * (State.TabH + State.TabGap)
		tabY[name] = y
		local btn = mkText({Size = UDim2.new(1, -12, 0, State.TabH), Position = UDim2.fromOffset(6, y), Text = (State.TabIcons and (icon .. "  ") or "") .. name, TextSize = State.TabTextSize,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, AutoButtonColor = false, Parent = tabScroll}, true, false, "TextButton")
		local pad = new("UIPadding", {PaddingLeft = UDim.new(0, 12), Parent = btn})
		tabBtns[name] = {btn = btn, icon = icon, pad = pad}
		local refresh = function(d)
			tween(btn, d or 0.2, {TextColor3 = current == name and activeColor() or T.sub})
		end
		table.insert(tabRefresh, refresh)
		table.insert(binders, refresh)
		btn.TextColor3 = T.sub
		btn.MouseButton1Click:Connect(function() switchTab(name) end)
		tabScroll.CanvasSize = UDim2.fromOffset(0, 16 + tabCount * (State.TabH + State.TabGap))
		return sc
	end

	relayoutTabs = function()
		local step = State.TabH + State.TabGap
		for name, b in pairs(tabBtns) do
			local y = 8 + (tabIdx[name] - 1) * step
			tabY[name] = y
			b.btn.Size = UDim2.new(1, -12, 0, State.TabH)
			b.btn.Position = UDim2.fromOffset(6, y)
			b.btn.TextSize = State.TabTextSize
			b.btn.Text = (State.TabIcons and (b.icon .. "  ") or "") .. name
			b.btn.TextXAlignment = (State.TabAlign == "Centro") and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
			b.pad.PaddingLeft = UDim.new(0, State.TabAlign == "Centro" and 0 or 12)
		end
		tabScroll.CanvasSize = UDim2.fromOffset(0, 16 + tabCount * step)
		local st = State.TabStyle
		indicator.Size = UDim2.new(1, -12, 0, State.TabH)
		indicator.BackgroundTransparency = (st == "Pílula") and 0 or (st == "Barra" and 0.82 or 0.7)
		indBar.Visible = (st == "Barra")
		indStroke.Enabled = (st == "Vidro")
		if current and tabY[current] then indicator.Position = UDim2.fromOffset(6, tabY[current]) end
		for _, f in ipairs(tabRefresh) do f(0.2) end
	end
end

