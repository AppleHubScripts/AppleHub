	bind(tabScroll, "ScrollBarImageColor3", "accent")
	local indicator = new("Frame", {Size = UDim2.new(1, -12, 0, State.TabH), Position = UDim2.fromOffset(6, 8), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 1, Parent = tabScroll}, {rc(11)})
	local indG = new("UIGradient", {Parent = indicator})
	bind(indG, "Color", function() return ColorSequence.new(T.accent, T.accent2) end, true)
	local indBar = new("Frame", {Size = UDim2.new(0, 3, 0.6, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0, Visible = false, ZIndex = 2, Parent = indicator}, {corner(2)})
