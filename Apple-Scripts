	local chip = new("Frame", {Size = UDim2.new(1, -12, 0, 40), Position = UDim2.new(0, 6, 1, -46), BackgroundColor3 = T.row, BackgroundTransparency = 0.25, Visible = State.ShowChip, Parent = side}, {rc(12)})
