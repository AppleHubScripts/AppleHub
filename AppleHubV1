local function new(c, p, k)
	local o = Instance.new(c)
	for a, b in pairs(p or {}) do if a ~= "Parent" then o[a] = b end end
	for _, x in ipairs(k or {}) do x.Parent = o end
	if p and p.Parent then o.Parent = p.Parent end
	return o
end
local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function tw(o, t, p, st)
	if S.ReducedMotion then
		for k, v in pairs(p) do pcall(function() o[k] = v end) end
		return
	end
	pcall(function() TS:Create(o, TweenInfo.new(t, st or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p):Play() end)
end
local FONTS = {Pixel = {Enum.Font.Arcade, Enum.Font.Arcade}, Clean = {Enum.Font.GothamMedium, Enum.Font.GothamBold}, Mono = {Enum.Font.Code, Enum.Font.Code}}
local fontObjs = setmetatable({}, {__mode = "k"})
local function fnt(bold) return (FONTS[S.Font] or FONTS.Pixel)[bold and 2 or 1] end
local function applyFont() for o, b in pairs(fontObjs) do pcall(function() o.Font = fnt(b) end) end end
local binds, syncs, repaints = {}, {}, {}
local function bind(o, prop, key) binds[#binds + 1] = {o, prop, key}; o[prop] = T[key] end
local function rebind() for _, b in ipairs(binds) do pcall(function() b[1][b[2]] = T[b[3]] end) end end
local function syncAll() for _, f in ipairs(syncs) do pcall(f) end end
local function txt(p, bold, ck, class)
	p.BackgroundTransparency = 1
	local o = new(class or "TextLabel", p)
	o.Font = fnt(bold)
	fontObjs[o] = bold
	if ck ~= false then bind(o, "TextColor3", ck or "text") end
	return o
end
local function stroke(parent, key, th)
	local s = new("UIStroke", {Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent})
	bind(s, "Color", key or "line")
	return s
end
