local GM = {safeUp = false, manual = false, loud = 0}
local UI = {}
function GM.root() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
function GM.hum() local c = lp.Character return c and c:FindFirstChildOfClass("Humanoid") end
function GM.invoke(...)
	local a = table.pack(...)
	local rem = RepS:FindFirstChild("Remotes")
	local cf = rem and rem:FindFirstChild("CommF_")
	if not cf then return nil end
	local ok, r = pcall(function() return cf:InvokeServer(table.unpack(a, 1, a.n)) end)
	return ok and r or nil
end
function GM.loop(iv, fn) task.spawn(function() while alive do task.wait(iv) pcall(fn) end end) end
function GM.val(n) local ok, v = pcall(function() return lp.Data[n].Value end) return ok and v or nil end
function GM.fmt(n)
	n = math.floor(tonumber(n) or 0)
	local neg = n < 0
	local s = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1" .. sep):reverse()
	if s:sub(1, 1) == sep then s = s:sub(2) end
	return (neg and "-" or "") .. s
end
function GM.anyAuto() return S.AutoLevel or S.Farm or S.AutoBoss or S.AutoElite or S.Chest or S.FruitGrab end
function GM.goTo(cf)
	local r = GM.root()
	if not r then return end
	local d = (cf.Position - r.Position).Magnitude
	if d < 80 then r.CFrame = cf return end
	local t = d / math.max(S.TravelSpeed, 50)
	local tween = TS:Create(r, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = cf})
	local done = false
	local c = tween.Completed:Connect(function() done = true end)
	tween:Play()
	local t1 = tick()
	while not done and alive and tick() - t1 < t + 1 do
		if not GM.anyAuto() and not GM.manual then tween:Cancel() break end
		task.wait(0.05)
	end
	c:Disconnect()
end
function GM.hoverTo(pos)
	local r = GM.root()
	if not r then return end
	local tp = pos + Vector3.new(0, GM.safeUp and 230 or S.Height, 0)
	if (tp - r.Position).Magnitude > 120 then GM.goTo(CFrame.new(tp)) else r.CFrame = CFrame.new(tp, pos) end
	r.AssemblyLinearVelocity = Vector3.zero
end
function GM.equip()
	local c = lp.Character
	if not c then return end
	local cur = c:FindFirstChildOfClass("Tool")
	if cur and cur.ToolTip == S.Weapon then return end
	local bp = lp:FindFirstChild("Backpack")
	if not bp then return end
	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == S.Weapon then
			local h = GM.hum()
			if h then h:EquipTool(t) end
			return
		end
	end
end
function GM.nearest(name)
	local r, folder = GM.root(), workspace:FindFirstChild("Enemies")
	if not r or not folder then return end
	local best, bd
	for _, m in ipairs(folder:GetChildren()) do
		if not name or m.Name == name then
			local h, mr = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart")
			if h and mr and h.Health > 0 then
				local d = (mr.Position - r.Position).Magnitude
				if not bd or d < bd then best, bd = mr, d end
			end
		end
	end
	return best
end
function GM.bring(target)
	if not S.Bring or not target then return end
	local folder = workspace:FindFirstChild("Enemies")
	if not folder then return end
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	for _, m in ipairs(folder:GetChildren()) do
		local h, mr = m:FindFirstChildOfClass("Humanoid"), m:FindFirstChild("HumanoidRootPart")
		if h and mr and h.Health > 0 and m.Name == target.Parent.Name and (mr.Position - target.Position).Magnitude < S.BringR then
			mr.CFrame = target.CFrame
			mr.CanCollide = false
			mr.AssemblyLinearVelocity = Vector3.zero
			h.WalkSpeed = 0
		end
	end
end
