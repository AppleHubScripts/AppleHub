	if S.Fullbright then
		Lighting.Brightness, Lighting.GlobalShadows = 2, false
		Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200), Color3.fromRGB(200, 200, 200)
