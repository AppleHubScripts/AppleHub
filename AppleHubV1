GM.base = {}
function GM.gain(n)
	local cur = GM.val(n)
	if cur and GM.base[n] == nil then GM.base[n] = cur end
	return (cur and GM.base[n]) and (cur - GM.base[n]) or 0
end
function GM.rate(n)
	local el = tick() - t0
	return el < 30 and 0 or GM.gain(n) / (el / 3600)
end
function GM.clock(s)
	s = math.floor(s)
	if s >= 3600 then return string.format("%d:%02d:%02d", math.floor(s / 3600), math.floor(s % 3600 / 60), s % 60) end
	return string.format("%02d:%02d", math.floor(s / 60), s % 60)
end
function GM.short(n) return (tostring(n):gsub("%-.*$", "")) end
function GM.fetchStock()
	local r = GM.invoke("GetFruits")
	if type(r) ~= "table" then return nil end
	local list = {}
	for _, f in pairs(r) do
		if type(f) == "table" and f.OnSale and f.Name then list[#list + 1] = {name = f.Name, price = tonumber(f.Price) or 0} end
	end
	table.sort(list, function(a, b) return a.price < b.price end)
	return list
end
function GM.hop()
