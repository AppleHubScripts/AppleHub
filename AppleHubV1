function GM.boost()
	pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
	Lighting.GlobalShadows = false
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then d.Enabled = false
		elseif d:IsA("BasePart") then d.CastShadow = false end
	end
	toast("FPS", L("Modo desempenho ativado.", "Performance mode on."), 2.5)
end

function GM.start()
	local lastQuest, lastAbandon, lastElite = 0, 0, 0
	GM.loop(0.1, function()
		if not S.AutoLevel then return end
		local r = GM.root()
		if not r then return end
		if S.AutoEquip then GM.equip() end
		local e = GM.questFor(GM.val("Level") or 1)
		if not e then local t = GM.nearest() if t then GM.hoverTo(t.Position); GM.bring(t) end return end
		local vis, title = false, ""
		pcall(function() vis = lp.PlayerGui.Main.Quest.Visible end)
		pcall(function() title = tostring(lp.PlayerGui.Main.Quest.Container.QuestTitle.Title.Text) end)
		if vis and not title:lower():find(e.mob:sub(1, 5):lower(), 1, true) and tick() - lastAbandon > 15 then
			GM.invoke("AbandonQuest"); lastAbandon = tick(); vis = false
		end
		if not vis then
			if tick() - lastQuest > 1.5 then
				GM.goTo(CFrame.new(e.q + Vector3.new(0, 3, 0)))
				task.wait(0.3)
				GM.invoke("StartQuest", e.qn, e.ql)
				lastQuest = tick()
			end
			return
		end
		local t = GM.nearest(e.mob)
		if t then GM.hoverTo(t.Position); GM.bring(t) else GM.goTo(CFrame.new(e.m + Vector3.new(0, S.Height, 0))) end
	end)
	GM.loop(0.02, function()
		if not S.Farm or S.AutoLevel or not GM.root() then return end
		if S.AutoEquip then GM.equip() end
		local t = GM.nearest()
		if t then GM.hoverTo(t.Position); GM.bring(t) end
	end)
	GM.loop(0.05, function()
		if not S.AutoBoss or S.AutoLevel or not GM.root() then return end
		if S.AutoEquip then GM.equip() end
		local t = GM.nearest(S.Boss)
		if t then GM.hoverTo(t.Position) end
	end)
	GM.loop(0.1, function()
		if not S.AutoElite or S.AutoLevel or not GM.root() then return end
		if S.AutoEquip then GM.equip() end
		local t
		for _, n in ipairs(GM.Elite) do t = GM.nearest(n) if t then break end end
		if t then GM.hoverTo(t.Position); GM.bring(t)
		elseif tick() - lastElite > 6 then lastElite = tick(); GM.invoke("EliteHunter") end
	end)
	task.spawn(function()
		while alive do
			task.wait(math.max(S.ClickDelay, 20) / 1000)
			if (S.Click or S.Farm or S.AutoLevel or S.AutoBoss or S.AutoElite) and not GM.safeUp then
