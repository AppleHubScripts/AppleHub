-- arrastar (suave ou instantâneo)
local drags = {}
local function makeDrag(handle, target)
	local d = {t = target, goal = target.Position, home = target.Position, moved = false}
	local active, start, origin
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			active, start, origin, d.moved = true, i.Position, d.goal, false
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then active = false end end)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local dl = i.Position - start
			if dl.Magnitude > 6 then d.moved = true end
			d.goal = UDim2.new(origin.X.Scale, origin.X.Offset + dl.X, origin.Y.Scale, origin.Y.Offset + dl.Y)
			if S.DragStyle ~= "Smooth" or S.ReducedMotion then target.Position = d.goal end
		end
	end))
	drags[#drags + 1] = d
	return d
end
track(RS.RenderStepped:Connect(function(dt)
	if S.DragStyle ~= "Smooth" or S.ReducedMotion then return end
	local k = math.min(1, dt * 14)
	for _, d in ipairs(drags) do
		local a, g = d.t.Position, d.goal
		if a ~= g then
			d.t.Position = UDim2.new(g.X.Scale, a.X.Offset + (g.X.Offset - a.X.Offset) * k, g.Y.Scale, a.Y.Offset + (g.Y.Offset - a.Y.Offset) * k)
		end
	end
end))

